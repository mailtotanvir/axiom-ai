// Prompt registry (O2): prompts as typed, versioned artifacts with
// environment promotion and immutable published versions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DB_URI")
}

model Prompt {
  id          String          @id @default(uuid())
  tenantId    String          @map("tenant_id")
  name        String
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  versions    PromptVersion[]

  @@unique([tenantId, name])
  @@map("prompts")
}

model PromptVersion {
  id             String    @id @default(uuid())
  promptId       String    @map("prompt_id")
  prompt         Prompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  semver         String
  template       String
  /// JSON Schema (draft-07) describing allowed template variables.
  templateSchema Json?     @map("template_schema")
  model          String?
  temperature    Float?
  /// draft | published | archived
  status         String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at")
  publishedAt    DateTime? @map("published_at")

  promotions PromptPromotion[]

  @@unique([promptId, semver])
  @@index([promptId, status])
  @@map("prompt_versions")
}

model PromptPromotion {
  id          String        @id @default(uuid())
  versionId   String        @map("version_id")
  version     PromptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// development | staging | production
  environment String
  promotedAt  DateTime      @default(now()) @map("promoted_at")
  promotedBy  String?       @map("promoted_by")

  @@unique([versionId, environment])
  @@map("prompt_promotions")
}

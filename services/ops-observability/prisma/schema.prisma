// Axiom AI control-plane metadata schema (Phase 4 epic O2/O3).
// Prompts are versioned, immutable artifacts; evals link datasets to
// prompt versions and store scored runs in ClickHouse (via O1).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DB_URI")
}

enum PromptEnvironment {
  development
  staging
  production
}

model Prompt {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  createdAt DateTime @default(now())

  versions PromptVersion[]

  @@unique([tenantId, name])
}

model PromptVersion {
  id            String   @id @default(cuid())
  promptId      String
  semver        String
  template      String
  variablesJson Json? // JSON Schema for template variables
  environment   PromptEnvironment @default(development)
  createdBy     String
  createdAt     DateTime @default(now())

  prompt    Prompt       @relation(fields: [promptId], references: [id])
  evalRuns  EvalRun[]

  @@unique([promptId, semver])
}

model EvalDataset {
  id        String   @id @default(cuid())
  name      String
  tenantId  String
  version   String
  casesJson Json // array of { input, expectedOutput?, context? }
  createdAt DateTime @default(now())

  evalRuns EvalRun[]

  @@unique([tenantId, name, version])
}

model EvalRun {
  id             String   @id @default(cuid())
  promptVersionId String
  datasetId      String
  model          String
  status         String   // queued | running | completed | failed
  metricsJson    Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id])
  dataset       EvalDataset   @relation(fields: [datasetId], references: [id])
}

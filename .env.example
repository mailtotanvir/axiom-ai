# Axiom AI environment contract (spec section 5).
# Copy to .env and adjust. Never commit real secrets.

# Core base infrastructure keys
AXIOM_ENV=development
AXIOM_INTER_SERVICE_SECRET=change-me-to-a-crypto-secure-hex-string-32+

# Cross-repo broker configuration
REDIS_PRIMARY_URL=redis://localhost:6379/0
CLICKHOUSE_NODES=axiom:axiom@localhost:8123
POSTGRES_DB_URI=postgresql://axiom:axiom@localhost:5432/axiom_metadata

# Upstream model authorization (optional; dev/test providers below suffice)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Dev/test providers (ADR 0006)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
MISTRAL_API_KEY=
SILICONFLOW_API_KEY=
NVIDIA_NIM_API_KEY=

# Gateway router endpoint definitions
GATEWAY_INTERNAL_URL=http://localhost:3000
RAG_PIPELINE_INTERNAL_URL=http://localhost:8000
AGENT_RUNTIME_INTERNAL_URL=http://localhost:5000
OBSERVABILITY_INTERNAL_URL=http://localhost:4000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Input cache (exact-match, tenant-scoped): {enabled,ttlSeconds,maxEntryBytes}
GATEWAY_INPUT_CACHE={"enabled":true,"ttlSeconds":3600,"maxEntryBytes":1048576}
# Anthropic-only: auto-mark trailing system block with cache_control
GATEWAY_ANTHROPIC_AUTO_SYSTEM_CACHE=false

# Service ports
GATEWAY_PORT=3000
